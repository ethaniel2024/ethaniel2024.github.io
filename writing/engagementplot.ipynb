import pandas as pd
import matplotlib.pyplot as plt

# Simulated scenarios
data = {
    "Scenario": [
        "High Density (BYU)",
        "Medium Density",
        "Low Density (Diluted)"
    ],
    "Attendance": [63000, 70000, 80000],
    "Engagement Factor": [0.95, 0.75, 0.55]
}

df = pd.DataFrame(data)

# Engagement Density Metric
df["Impact Score"] = df["Attendance"] * df["Engagement Factor"]

# Plot
plt.figure()
plt.bar(df["Scenario"], df["Impact Score"])
plt.title("Atmosphere Impact: Engagement Density vs Capacity")
plt.xlabel("Scenario")
plt.ylabel("Impact Score (Attendance × Engagement)")
plt.xticks(rotation=15)
plt.tight_layout()
plt.show()

plt.savefig("visuals/engagement_density.png")
